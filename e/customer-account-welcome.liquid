<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>You're on the list</title>
  <!-- Carrara Design fonts: Barlow for text, Carrara Mono for labels, Helvetica Neue Bold Italic for the heading, in the brand grey used for headings in light mode.
       Mail apps that can't load web fonts fall back to the closest system font. -->
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    @font-face{font-family:'Carrara Mono';src:url(https://carrara.design/fonts/carrara-mono-400.woff2) format('woff2');font-weight:400;font-style:normal}
    body{margin:0;padding:0;background:#f5f5f3;-webkit-text-size-adjust:100%}
    .barlow{font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif}
    .mono{font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace}
    .display{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
    a{color:#101010}
    @media (max-width:600px){
      .wrap{width:100%!important}
      .pad{padding-left:24px!important;padding-right:24px!important}
      .h1{font-size:30px!important}
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f5f5f3;">
  <div style="display:none;max-height:0;overflow:hidden;">We'll email you the moment our first drop opens.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f5f3" style="background:#f5f5f3;">
    <tr>
      <td align="center" style="padding:28px 0 40px;">
        <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f5f3" style="width:600px;max-width:600px;background:#f5f5f3;">

          <!-- Wordmark -->
          <tr>
            <td align="center" style="padding:18px 24px 26px;">
              <a href="https://carrara.design/" style="text-decoration:none;">
                <img src="https://carrara.design/logo-grey.png" width="96" alt="Carrara Design" style="display:block;width:96px;height:auto;border:0;">
              </a>
            </td>
          </tr>

          <!-- The Serafino cars -->
          <tr>
            <td class="pad" style="padding:0 20px;">
              <a href="https://carrara.design/" style="text-decoration:none;">
                <img src="https://carrara.design/img/notify/teaser-1600.jpg" width="560" alt="The Serafino GT2 RS and GT3 RS in the studio" style="display:block;width:100%;max-width:560px;height:auto;border:0;border-radius:14px;">
              </a>
            </td>
          </tr>

          <!-- Message -->
          <tr>
            <td class="pad" style="padding:30px 40px 0;">
              <p class="mono" style="margin:0 0 14px;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#8a8a88;">The Serafino Collection</p>
              <h1 class="display h1" style="margin:0 0 20px;font-family:'Helvetica Neue',Helvetica,'Arial',sans-serif;font-size:36px;line-height:1.05;font-weight:700;font-style:italic;color:#9b9c9b;">You're on the list.</h1>
              <p class="barlow" style="margin:0 0 16px;font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:17px;line-height:1.7;font-weight:300;color:#3a3a3a;">Thank you for joining Carrara Design. For over a decade we've helped collectors design their cars before they're built. Our first drop brings that work home, starting with the Serafino Collection.</p>
              <p class="barlow" style="margin:0 0 32px;font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:17px;line-height:1.7;font-weight:300;color:#3a3a3a;">We'll email you the moment it opens, plus the occasional update from the studio.</p>
            </td>
          </tr>

          <!-- Button -->
          <tr>
            <td class="pad" style="padding:0 40px 44px;">
              <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0px auto 0;"><tr>
                <td align="center" bgcolor="#101010" style="background:#101010;border-radius:999px;">
                  <a href="https://carrara.design/" class="mono" style="display:inline-block;padding:16px 32px;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#ffffff;text-decoration:none;">Visit the studio</a>
                </td>
              </tr></table>
            </td>
          </tr>

          <!-- Footer: the Italian line across, like the site footer -->
          <tr>
            <td style="padding:0;font-size:0;line-height:0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                <td width="33%" height="3" bgcolor="#4e765c" style="height:3px;background:#4e765c;font-size:0;line-height:0;">&nbsp;</td>
                <td width="34%" height="3" bgcolor="#ffffff" style="height:3px;background:#ffffff;font-size:0;line-height:0;">&nbsp;</td>
                <td width="33%" height="3" bgcolor="#aa2f39" style="height:3px;background:#aa2f39;font-size:0;line-height:0;">&nbsp;</td>
              </tr></table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:34px 24px 8px;">
              <img src="https://carrara.design/wordmark-grey.png" width="190" alt="Carrara Design" style="display:block;width:190px;max-width:55%;height:auto;border:0;">
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:14px 24px 0;">
              <p class="mono" style="margin:0;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;line-height:2.1;color:#8a8a88;">
                <a href="mailto:contact@carrara.design" style="color:#8a8a88;text-decoration:none;">contact@carrara.design</a><br>
                <a href="https://www.instagram.com/carrara_design/" style="color:#8a8a88;text-decoration:none;">Instagram @carrara_design</a><br>
                &copy; {{ 'now' | date: '%Y' }} Carrara Design
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
