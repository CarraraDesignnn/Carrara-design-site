<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>Invoice {{ name }}</title>
  <!-- Carrara Design fonts: Barlow for text, Carrara Mono for labels, Helvetica Neue Bold Italic for the heading, in the brand grey used for headings in light mode.
       Mail apps that can't load web fonts fall back to the closest system font. -->
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    @font-face{font-family:'Carrara Mono';src:url(https://carrara.design/fonts/carrara-mono-400.woff2) format('woff2');font-weight:400;font-style:normal}
    body{margin:0;padding:0;background:#f5f5f3;-webkit-text-size-adjust:100%}
    .barlow{font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif}
    .mono{font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace}
    .display{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
    a{color:#101010}
    @media (max-width:600px){
      .wrap{width:100%!important}
      .pad{padding-left:24px!important;padding-right:24px!important}
      .h1{font-size:30px!important}
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f5f5f3;">
  <div style="display:none;max-height:0;overflow:hidden;">Your invoice from Carrara Design.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f5f3" style="background:#f5f5f3;">
    <tr>
      <td align="center" style="padding:28px 0 40px;">
        <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f5f3" style="width:600px;max-width:600px;background:#f5f5f3;">

          <!-- Logo -->
          <tr>
            <td align="center" style="padding:14px 24px 64px;">
              <a href="https://carrara.design/" style="text-decoration:none;">
                <img src="https://carrara.design/logo-grey.png" width="80" alt="Carrara Design" style="display:block;width:80px;height:auto;border:0;">
              </a>
            </td>
          </tr>

{% if checkout_payment_collection_url %}{% assign pay_url = checkout_payment_collection_url %}{% else %}{% assign pay_url = invoice_url %}{% endif %}
          <tr>
            <td class="pad" style="padding:0 40px;">
              <p class="mono" style="margin:0 0 14px;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8a8a88;">Invoice {{ name }}</p><h1 class="display h1" style="margin:0 0 20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:28px;line-height:1.1;font-weight:700;font-style:italic;color:#9b9c9b;">Your invoice{% if customer.first_name != blank %}, {{ customer.first_name }}{% endif %}.</h1><p class="barlow" style="margin:0 0 40px;font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;font-weight:300;color:#3a3a3a;">{% if custom_message != blank %}{{ custom_message }}{% else %}Here is your invoice from Carrara Design. You can review it and pay securely below.{% endif %}</p>
            </td>
          </tr>
          <tr>
            <td class="pad" style="padding:0 40px;">
              <p class="mono" style="margin:0;padding:0 0 12px;border-bottom:1px solid #e2e2df;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8a8a88;">Your order</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                {% for line in subtotal_line_items %}
                <tr>
                  <td width="68" valign="middle" style="padding:14px 14px 14px 0;border-bottom:1px solid #e2e2df;">
                    {% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" width="54" height="54" alt="" style="display:block;width:54px;height:54px;object-fit:cover;border:0;border-radius:8px;">{% endif %}
                  </td>
                  <td valign="middle" style="padding:14px 0;border-bottom:1px solid #e2e2df;font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.4;color:#101010;">
                    {%- assign t = line.title | split: ' — ' -%}
                    <span style="font-weight:500;">{{ t | first }}</span>{% if t.size > 1 %}<br><span style="color:#8a8a88;">{{ t | last }}</span>{% endif %}
                    {% if line.variant.title != 'Default Title' and line.variant.title != blank %}<br><span style="font-size:14px;color:#8a8a88;">{{ line.variant.title }}</span>{% endif %}
                    {% if line.quantity > 1 %}<br><span class="mono" style="font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#8a8a88;">Qty {{ line.quantity }}</span>{% endif %}
                  </td>
                  <td valign="middle" align="right" style="padding:14px 0 14px 12px;border-bottom:1px solid #e2e2df;font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#101010;white-space:nowrap;">{{ line.final_line_price | money }}</td>
                </tr>
                {% endfor %}
              </table>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;font-family:'Barlow','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:300;color:#3a3a3a;">
                <tr><td style="padding:5px 0;">Subtotal</td><td align="right" style="padding:5px 0;">{{ subtotal_price | money }}</td></tr>
                {% for discount in discounts %}<tr><td style="padding:5px 0;">Discount{% if discount.code %} ({{ discount.code }}){% endif %}</td><td align="right" style="padding:5px 0;">−{{ discount.amount | money }}</td></tr>{% endfor %}
                <tr><td style="padding:5px 0;">Shipping</td><td align="right" style="padding:5px 0;">{{ shipping_price | money }}</td></tr>
                {% if tax_price > 0 %}<tr><td style="padding:5px 0;">Tax</td><td align="right" style="padding:5px 0;">{{ tax_price | money }}</td></tr>{% endif %}
                <tr><td style="padding:12px 0 0;border-top:1px solid #e2e2df;font-size:15px;font-weight:500;color:#101010;">Total</td><td align="right" style="padding:12px 0 0;border-top:1px solid #e2e2df;font-size:15px;font-weight:500;color:#101010;">{{ total_price | money_with_currency }}</td></tr>
              </table>
              <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:28px auto 0;"><tr>
                <td align="center" bgcolor="#101010" style="background:#101010;border-radius:999px;">
                  <a href="{{ pay_url }}" class="mono" style="display:inline-block;padding:13px 26px;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#ffffff;text-decoration:none;">Review and pay</a>
                </td>
              </tr></table>
            </td>
          </tr>
          <tr><td style="padding:0 0 56px;"></td></tr>
          <!-- Footer: the Italian line across, like the site footer -->
          <tr>
            <td style="padding:0;font-size:0;line-height:0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                <td width="33%" height="3" bgcolor="#4e765c" style="height:3px;background:#4e765c;font-size:0;line-height:0;">&nbsp;</td>
                <td width="34%" height="3" bgcolor="#ffffff" style="height:3px;background:#ffffff;font-size:0;line-height:0;">&nbsp;</td>
                <td width="33%" height="3" bgcolor="#aa2f39" style="height:3px;background:#aa2f39;font-size:0;line-height:0;">&nbsp;</td>
              </tr></table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:34px 24px 8px;">
              <img src="https://carrara.design/wordmark-grey.png" width="190" alt="Carrara Design" style="display:block;width:190px;max-width:55%;height:auto;border:0;">
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:14px 24px 0;">
              <p class="mono" style="margin:0;font-family:'Carrara Mono',Menlo,Consolas,'Courier New',monospace;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;line-height:2.1;color:#8a8a88;">
                <a href="mailto:contact@carrara.design" style="color:#8a8a88;text-decoration:none;">contact@carrara.design</a><br>
                <a href="https://www.instagram.com/carrara_design/" style="color:#8a8a88;text-decoration:none;">Instagram @carrara_design</a><br>
                &copy; {{ 'now' | date: '%Y' }} Carrara Design
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
